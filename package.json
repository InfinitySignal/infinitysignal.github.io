{
	"name": "astro-base",
	"type": "module",
	"version": "0.0.1",
	"license": "MIT",
	"scripts": {
		"dev": "astro dev",
		"build": "node scripts/prepare-assets.mjs && astro build && node scripts/finalize-seo.mjs && node scripts/check-seo.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx,.astro",
		"lint:fix": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx,.astro --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "astro check",
		"check": "npm run type-check && npm run lint && npm run format:check",
		"predev": "node scripts/prepare-assets.mjs",
		"test:seo": "node scripts/check-seo.mjs"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.0",
		"@astrojs/react": "^5.0.0",
		"@iconify-json/tabler": "^1.2.26",
		"@tailwindcss/vite": "^4.1.18",
		"astro": "^6.0.4",
		"astro-icon": "^1.1.5",
		"framer-motion": "^12.24.7",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"sass": "^1.97.2",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@tailwindcss/typography": "^0.5.19",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.57.0",
		"eslint-plugin-astro": "^1.6.0",
		"eslint-plugin-react": "^7.34.0",
		"eslint-plugin-react-hooks": "^4.6.0",
		"parse5": "^7.3.0",
		"prettier": "^3.2.5",
		"prettier-plugin-astro": "^0.14.1",
		"sharp": "^0.34.5",
		"terser": "^5.51.2"
	}
}
