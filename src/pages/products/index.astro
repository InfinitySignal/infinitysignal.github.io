---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../config/site.mjs";
import {
	getProductHref,
	getProductLogo,
	getProducts,
} from "../../utils/products";

const products = getProducts();
---

<Layout
	title={`Products - ${SITE.title}`}
	description="Explore InfinitySignal products and published product outputs."
	canonicalURL={`${SITE.url}/products`}
>
	<Header />
	<main id="main-content" role="main" class="max-w-4xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-bold text-gray-900 mb-4">Products</h1>

		{
			products.length > 0 ? (
				<div class="grid sm:grid-cols-2 gap-4">
					{products.map((product) => (
						<a
							href={getProductHref(product)}
							class="group block p-5 bg-white border border-gray-200 rounded-lg hover:border-gray-400 hover:shadow-sm transition-all"
						>
							<div class="flex items-start justify-between gap-4">
								<div class="flex min-w-0 items-start gap-3">
									<img
										src={getProductLogo(product)}
										alt={`${product.title} logo`}
										class="h-11 w-11 shrink-0 rounded-lg border border-gray-200 object-contain p-1.5"
										loading="lazy"
									/>
									<div class="min-w-0">
										<h2 class="text-lg font-medium text-gray-900">
											{product.title}
										</h2>
										<p class="text-gray-600 mt-1 text-sm">
											{product.description}
										</p>
									</div>
								</div>
								<Icon
									name="tabler:arrow-up-right"
									class="w-5 h-5 text-gray-400 group-hover:text-gray-700 transition-colors shrink-0"
									aria-hidden="true"
								/>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="bg-white border border-gray-200 rounded-lg p-6">
					<h2 class="text-lg font-medium text-gray-900">
						No products published yet.
					</h2>
					<p class="text-gray-600 mt-2">
						Add products to the site configuration to show them here.
					</p>
				</div>
			)
		}
	</main>
	<Footer />
</Layout>
