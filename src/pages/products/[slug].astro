---
import { getTranslations } from "../../i18n";
type Props = Record<string, never>;
import { enhancePublishedHtml } from "../../utils/published-seo.mjs";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../config/site.mjs";
import {
	getProductHtmlFiles,
	getProductLogo,
	getProducts,
	isExternalProduct,
	type Product,
} from "../../utils/products";

export function getStaticPaths() {
	return getProducts()
		.filter((product) => !isExternalProduct(product))
		.map((product) => ({
			params: { slug: product.slug },
		}));
}

const { locale, t, path } = getTranslations(Astro.url);

const product = getProducts(locale).find(
	(candidate) => candidate.slug === Astro.params.slug
) as Product;
if (product.landingPage) {
	const html = readFileSync(
		join(process.cwd(), "public", product.landingPage),
		"utf-8"
	);
	return new Response(
		enhancePublishedHtml(html, `/products/${product.slug}/`),
		{
			headers: { "Content-Type": "text/html; charset=utf-8" },
		}
	);
}
const reportTitle = (name: string) => {
	const match = /^(\d{4}-\d{2}-\d{2})_sp500_risk(_backtest)?\.html$/.exec(name);
	return match
		? `${match[1]} ${match[2] ? t.backtestReport : t.dailyReport}`
		: name;
};
const htmlFiles = getProductHtmlFiles(product.slug);
---

<Layout
	title={`${product.title} | ${SITE.title}`}
	description={product.description || t.reports}
	canonicalURL={new URL(path(`/products/${product.slug}`), SITE.url).href}
>
	<Header />
	<main id="main-content" role="main" class="max-w-4xl mx-auto px-4 py-16">
		<a
			href={path("/products")}
			class="text-sm text-gray-600 hover:text-gray-900 transition-colors mb-6 inline-block"
		>
			&larr; {t.backProducts}
		</a>

		<div class="mb-4 flex items-center gap-4">
			<img
				src={getProductLogo(product)}
				width="128"
				height="128"
				decoding="async"
				alt={`${product.title} ${t.logo}`}
				class="h-14 w-14 shrink-0 rounded-xl border border-gray-200 object-contain p-2"
			/>
			<h1 class="text-4xl font-bold text-gray-900">{product.title}</h1>
		</div>
		<p class="text-lg text-gray-600 mb-10">{product.description}</p>

		<p class="text-sm text-gray-500 mb-4">{t.originalLanguage}</p>
		<section aria-label={t.reports}>
			{
				htmlFiles.length > 0 ? (
					<ul class="space-y-3" role="list">
						{htmlFiles.map((file) => (
							<li>
								<a
									href={file.href}
									class="group flex items-center justify-between gap-4 p-4 bg-white border border-gray-200 rounded-lg hover:border-gray-400 hover:shadow-sm transition-all"
								>
									<span class="font-medium text-gray-900 break-all">
										{reportTitle(file.fileName)}
									</span>
									<Icon
										name="tabler:arrow-up-right"
										class="w-5 h-5 text-gray-400 group-hover:text-gray-700 transition-colors shrink-0"
										aria-hidden="true"
									/>
								</a>
							</li>
						))}
					</ul>
				) : (
					<div class="bg-white border border-gray-200 rounded-lg p-6">
						<h3 class="text-lg font-medium text-gray-900">{t.noReports}</h3>
						<p class="text-gray-600 mt-2">{t.noReportsDescription}</p>
					</div>
				)
			}
		</section>
	</main>
	<Footer />
</Layout>
