---
import { Icon } from "astro-icon/components";
import ProductMenuItems from "./ProductMenuItems.astro";
import { getProducts } from "../utils/products";

const products = getProducts();
const isProductsActive = Astro.url.pathname.startsWith("/products");
---

<header
	class="w-full py-4 px-4 border-b border-gray-200 bg-white sticky top-0 z-50"
	role="banner"
>
	<nav
		class="max-w-6xl mx-auto flex items-center justify-between"
		aria-label="Main navigation"
	>
		<a
			href="/"
			class="flex items-center gap-2 text-2xl font-bold text-gray-900 hover:text-gray-700 transition-colors"
			aria-label="InfinitySignal - Home"
		>
			<img src="/logo.png" alt="InfinitySignal" class="h-8 w-auto block" />
			<span>InfinitySignal</span>
		</a>

		<!-- Mobile menu button -->
		<button
			type="button"
			class="md:hidden p-2 text-gray-600 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 rounded-lg"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
			id="mobile-menu-button"
		>
			<Icon name="tabler:menu-2" class="w-6 h-6" aria-hidden="true" />
		</button>

		<!-- Desktop navigation -->
		<ul class="hidden md:flex items-center gap-6" role="list">
			<li>
				<a
					href="/"
					class="text-gray-600 hover:text-gray-900 transition-colors"
					aria-current={Astro.url.pathname === "/" ? "page" : undefined}
				>
					Home
				</a>
			</li>
			<li>
				<a
					href="/docs"
					class="text-gray-600 hover:text-gray-900 transition-colors"
					aria-current={Astro.url.pathname.startsWith("/docs")
						? "page"
						: undefined}
				>
					Docs
				</a>
			</li>
			<li>
				<div class="relative group">
					<button
						type="button"
						class={`inline-flex cursor-default items-center gap-1 rounded text-gray-600 transition-colors hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-4 ${
							isProductsActive ? "text-gray-900" : ""
						}`}
						aria-haspopup="menu"
					>
						Products
						<Icon
							name="tabler:chevron-down"
							class="h-4 w-4 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
							aria-hidden="true"
						/>
					</button>
					<div
						class="invisible pointer-events-none absolute left-1/2 top-full z-50 w-80 -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100"
					>
						<div
							class="rounded-xl border border-gray-200 bg-white p-2 shadow-lg"
						>
							<ProductMenuItems products={products} class="space-y-1" />
						</div>
					</div>
				</div>
			</li>
			<li>
				<a
					href="/contact"
					class="text-gray-600 hover:text-gray-900 transition-colors"
					aria-current={Astro.url.pathname === "/contact" ? "page" : undefined}
				>
					Contact
				</a>
			</li>
			<li>
				<a
					href="https://github.com/InfinitySignal"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors"
					aria-label="GitHub (opens in new tab)"
				>
					<Icon name="tabler:brand-github" class="w-4 h-4" aria-hidden="true" />
					GitHub
				</a>
			</li>
		</ul>
	</nav>

	<!-- Mobile menu -->
	<div
		id="mobile-menu"
		class="hidden md:hidden border-t border-gray-200 bg-white"
		role="menu"
		aria-labelledby="mobile-menu-button"
	>
		<ul class="flex flex-col py-4" role="list">
			<li>
				<a
					href="/"
					class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
					role="menuitem"
					aria-current={Astro.url.pathname === "/" ? "page" : undefined}
				>
					Home
				</a>
			</li>
			<li>
				<a
					href="/docs"
					class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
					role="menuitem"
					aria-current={Astro.url.pathname.startsWith("/docs")
						? "page"
						: undefined}
				>
					Docs
				</a>
			</li>
			<li>
				<button
					type="button"
					id="mobile-products-button"
					class={`flex w-full items-center justify-between gap-3 px-4 py-3 text-left font-medium transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-black ${
						isProductsActive ? "text-gray-900" : "text-gray-600"
					}`}
					aria-expanded="false"
					aria-controls="mobile-products-menu"
				>
					<span>Products</span>
					<Icon
						name="tabler:chevron-down"
						class="h-4 w-4 transition-transform"
						aria-hidden="true"
						data-mobile-products-chevron
					/>
				</button>
				<div id="mobile-products-menu" class="hidden">
					<ProductMenuItems
						products={products}
						class="mx-4 mb-2 space-y-1 border-l border-gray-200 pl-3"
					/>
				</div>
			</li>
			<li>
				<a
					href="/contact"
					class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
					role="menuitem"
					aria-current={Astro.url.pathname === "/contact" ? "page" : undefined}
				>
					Contact
				</a>
			</li>
			<li>
				<a
					href="https://github.com/InfinitySignal"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-2 px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
					role="menuitem"
					aria-label="GitHub (opens in new tab)"
				>
					<Icon name="tabler:brand-github" class="w-4 h-4" aria-hidden="true" />
					GitHub
				</a>
			</li>
		</ul>
	</div>
</header>

<script>
	// Mobile menu toggle functionality
	const menuButton = document.getElementById("mobile-menu-button");
	const mobileMenu = document.getElementById("mobile-menu");
	const mobileProductsButton = document.getElementById(
		"mobile-products-button"
	);
	const mobileProductsMenu = document.getElementById("mobile-products-menu");
	const mobileProductsChevron = document.querySelector(
		"[data-mobile-products-chevron]"
	);

	const closeMobileProductsMenu = () => {
		if (!mobileProductsButton || !mobileProductsMenu) return;

		mobileProductsButton.setAttribute("aria-expanded", "false");
		mobileProductsMenu.classList.add("hidden");
		mobileProductsChevron?.classList.remove("rotate-180");
	};

	if (menuButton && mobileMenu) {
		menuButton.addEventListener("click", () => {
			const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
			menuButton.setAttribute("aria-expanded", String(!isExpanded));
			mobileMenu.classList.toggle("hidden");

			if (isExpanded) {
				closeMobileProductsMenu();
			}
		});

		if (mobileProductsButton && mobileProductsMenu) {
			mobileProductsButton.addEventListener("click", () => {
				const isExpanded =
					mobileProductsButton.getAttribute("aria-expanded") === "true";

				mobileProductsButton.setAttribute("aria-expanded", String(!isExpanded));
				mobileProductsMenu.classList.toggle("hidden", isExpanded);
				mobileProductsChevron?.classList.toggle("rotate-180", !isExpanded);
			});
		}

		// Close menu when clicking outside
		document.addEventListener("click", (e) => {
			if (
				!menuButton.contains(e.target as Node) &&
				!mobileMenu.contains(e.target as Node) &&
				!mobileMenu.classList.contains("hidden")
			) {
				menuButton.setAttribute("aria-expanded", "false");
				mobileMenu.classList.add("hidden");
				closeMobileProductsMenu();
			}
		});

		// Close menu on escape key
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
				menuButton.setAttribute("aria-expanded", "false");
				mobileMenu.classList.add("hidden");
				closeMobileProductsMenu();
				menuButton.focus();
			}
		});
	}
</script>
