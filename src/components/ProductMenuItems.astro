---
import { Icon } from "astro-icon/components";
import {
	getProductHref,
	getProductLogo,
	type Product,
} from "../utils/products";

interface Props {
	products: Product[];
	class?: string;
}

const { products, class: className = "" } = Astro.props;
---

<ul class={className} role="menu">
	{
		products.map((product) => (
			<li role="none">
				<a
					href={getProductHref(product)}
					class="group/item flex items-center gap-3 rounded-lg px-3 py-3 text-left transition-colors hover:bg-gray-50 focus:bg-gray-50 focus:outline-none"
					role="menuitem"
				>
					<img
						src={getProductLogo(product)}
						alt={`${product.title} logo`}
						class="h-9 w-9 shrink-0 rounded-md border border-gray-200 object-contain p-1"
						loading="lazy"
					/>
					<span class="min-w-0 flex-1">
						<span class="block text-sm font-medium text-gray-900">
							{product.title}
						</span>
						<span class="mt-0.5 block truncate text-xs text-gray-500">
							{product.description}
						</span>
					</span>
					<Icon
						name="tabler:arrow-up-right"
						class="h-4 w-4 shrink-0 text-gray-400 transition-colors group-hover/item:text-gray-700"
						aria-hidden="true"
					/>
				</a>
			</li>
		))
	}
</ul>
