---
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="w-full py-12 px-4 border-t border-gray-200 bg-white"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">InfinitySignal</h2>
        <p class="text-gray-600">
          Making Sense of the Infinite Signal
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Links</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Home</a
            >
          </li>
          <li>
            <a
              href="/docs"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Docs</a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Contact</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Connect</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="https://github.com/InfinitySignal"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit our GitHub (opens in new tab)"
            >
              <Icon name="tabler:brand-github" class="w-5 h-5" aria-hidden="true" />
              <span>GitHub</span></a
            >
          </li>
          <li>
            <a
              href="mailto:official@infinitysignal.cn"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
            >
              <Icon name="tabler:mail" class="w-5 h-5" aria-hidden="true" />
              <span>Email</span></a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-gray-200 text-center text-gray-600 space-y-2">
      <p>&copy; {new Date().getFullYear()} InfinitySignal. All rights reserved.</p>
      <p class="text-sm">ICP备案号：占位符</p>
    </div>
  </div>
</footer>
