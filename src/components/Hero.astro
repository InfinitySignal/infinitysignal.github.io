---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import ProductMenuItems from "./ProductMenuItems.astro";
import { getProducts } from "../utils/products";

const products = getProducts();
---

<section
	class="max-w-6xl mx-auto px-4 py-20 md:py-32 text-center"
	aria-labelledby="hero-heading"
>
	<ScrollReveal client:load>
		<h1
			id="hero-heading"
			class="text-5xl md:text-6xl font-bold text-gray-900 mb-6"
		>
			Transforming Chaos into Clear Signal
		</h1>
	</ScrollReveal>
	<ScrollReveal client:load delay={0.2}>
		<p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-2xl mx-auto">
			InfinitySignal builds tools and platforms to process, analyze, and
			understand complex signal data.
		</p>
	</ScrollReveal>
	<ScrollReveal client:load delay={0.4}>
		<div class="flex flex-col sm:flex-row gap-4 justify-center">
			<a
				href="https://github.com/InfinitySignal"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium"
				aria-label="Visit our GitHub (opens in new tab)"
			>
				<Icon name="tabler:brand-github" class="w-5 h-5" aria-hidden="true" />
				<span>GitHub</span>
			</a>
			<div class="relative group" data-hero-products>
				<button
					type="button"
					class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-8 py-3 font-medium text-gray-900 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 sm:w-auto"
					aria-haspopup="menu"
					aria-expanded="false"
					aria-controls="hero-products-menu"
					data-hero-products-button
				>
					<Icon name="tabler:apps" class="w-5 h-5" aria-hidden="true" />
					<span>Products</span>
					<Icon
						name="tabler:chevron-down"
						class="h-4 w-4 transition-transform md:group-hover:rotate-180"
						aria-hidden="true"
						data-hero-products-chevron
					/>
				</button>
				<div
					id="hero-products-menu"
					class="absolute left-1/2 top-full z-40 hidden w-[min(20rem,calc(100vw-2rem))] -translate-x-1/2 pt-3 text-left transition-all duration-150 md:block md:invisible md:pointer-events-none md:translate-y-1 md:opacity-0 md:group-hover:visible md:group-hover:pointer-events-auto md:group-hover:translate-y-0 md:group-hover:opacity-100"
					data-hero-products-menu
				>
					<div class="rounded-xl border border-gray-200 bg-white p-2 shadow-lg">
						<ProductMenuItems products={products} class="space-y-1" />
					</div>
				</div>
			</div>
			<a
				href="/docs"
				class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors font-medium"
			>
				<Icon name="tabler:file-text" class="w-5 h-5" aria-hidden="true" />
				<span>Documentation</span>
			</a>
		</div>
	</ScrollReveal>
</section>

<script>
	const heroProducts = document.querySelector("[data-hero-products]");
	const heroProductsButton = document.querySelector(
		"[data-hero-products-button]"
	);
	const heroProductsMenu = document.querySelector("[data-hero-products-menu]");
	const heroProductsChevron = document.querySelector(
		"[data-hero-products-chevron]"
	);

	const setHeroProductsOpen = (isOpen: boolean) => {
		if (!heroProductsButton || !heroProductsMenu) return;

		heroProductsButton.setAttribute("aria-expanded", String(isOpen));
		heroProductsMenu.classList.toggle("hidden", !isOpen);
		heroProductsChevron?.classList.toggle("rotate-180", isOpen);
	};

	if (heroProducts && heroProductsButton && heroProductsMenu) {
		heroProductsButton.addEventListener("click", () => {
			const isExpanded =
				heroProductsButton.getAttribute("aria-expanded") === "true";
			setHeroProductsOpen(!isExpanded);
		});

		document.addEventListener("click", (event) => {
			if (!heroProducts.contains(event.target as Node)) {
				setHeroProductsOpen(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				setHeroProductsOpen(false);
			}
		});
	}
</script>
